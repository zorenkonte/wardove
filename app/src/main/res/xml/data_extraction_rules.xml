<?xml version="1.0" encoding="utf-8"?><!--
   Wardove's data is entirely local (Room DB + item photos + DataStore prefs — see
   CLAUDE.md). Back up all of it so a cloud restore or device transfer brings a user's
   wardrobe with it; exclude the transient diagnostic log and cache files.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="images/" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="images/" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>