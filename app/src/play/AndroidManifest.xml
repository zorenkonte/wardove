<?xml version="1.0" encoding="utf-8"?>
<!--
    Play-flavor manifest overlay. Google Play policy forbids apps from installing
    updates outside the store, so the Play build must not request the sideload
    permission. The updater UI is gated on BuildConfig.SELF_UPDATE_ENABLED.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
